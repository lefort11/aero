<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Старые наборы MSVC загружают версию поставляемых библиотек здесь, современные уже задали её. -->
  <Import Project="$(VCInstallDir)Auxiliary\Build\Microsoft.VCRedistVersion.default.props" Condition="'$(VCToolsRedistDir)'=='' and '$(VCToolsRedistVersion)'=='' and Exists('$(VCInstallDir)Auxiliary\Build\Microsoft.VCRedistVersion.default.props')" />
  <PropertyGroup Condition="'$(VCToolsRedistDir)'=='' and '$(VCToolsRedistVersion)'!=''">
    <VCToolsRedistDir>$(VCInstallDir)Redist\MSVC\$(VCToolsRedistVersion)</VCToolsRedistDir>
  </PropertyGroup>
  <Target Name="PublishAeroExecutable" AfterTargets="Build" Condition="'$(DesignTimeBuild)'!='true'">
    <PropertyGroup><AeroBin Condition="'$(AeroBin)'==''">$(MSBuildProjectDirectory)\..\bin</AeroBin></PropertyGroup>
    <ItemGroup Condition="'$(WithOpenMP)'=='true' and '$(Configuration)'=='Release'">
      <AeroOpenMPRuntime Include="$(VCToolsRedistDir)\$(Platform)\Microsoft.VC*.OpenMP\vcomp140.dll" />
    </ItemGroup>
    <Error Condition="'$(WithOpenMP)'=='true' and '$(Configuration)'=='Release' and '@(AeroOpenMPRuntime)'==''" Text="Cannot locate the release OpenMP redistributable under $(VCToolsRedistDir)." />
    <MakeDir Directories="$(AeroBin)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(AeroBin)" />
    <Copy SourceFiles="@(AeroOpenMPRuntime)" DestinationFolder="$(AeroBin)" SkipUnchangedFiles="true" Retries="3" />
  </Target>
</Project>
