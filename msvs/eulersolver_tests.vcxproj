    <None Include="..\source\eulersolver\README.txt" /><None Include="..\source\eulersolver\eulersolver.mk" />
  </ItemGroup>
  <ItemGroup><ProjectReference Include="aero_eulersolver.vcxproj"><Project>{4FCA0C0C-DA79-463C-99C2-76F0CC9F8456}</Project></ProjectReference></ItemGroup>
  <PropertyGroup>
    <RunEulersolverTests Condition="'$(RunEulersolverTests)'==''">true</RunEulersolverTests>
    <EulerTestArguments Condition="'$(RequireCudaTests)'=='true'">--require-cuda</EulerTestArguments>
    <CudaCompatibilityFlags Condition="'$(AllowUnsupportedCudaHostCompiler)'=='true'">-allow-unsupported-compiler -D_ALLOW_COMPILER_AND_STL_VERSION_MISMATCH</CudaCompatibilityFlags>
    <EulerCudaFlags Condition="'$(Configuration)'=='Debug'">-G -g -O0 -Xcompiler=/MTd</EulerCudaFlags>
    <EulerCudaFlags Condition="'$(Configuration)'!='Debug'">-O2 -Xcompiler=/MT</EulerCudaFlags>
    <LocalDebuggerWorkingDirectory>$(MSBuildProjectDirectory)\..</LocalDebuggerWorkingDirectory>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(WithCuda)'=='true'">
    <ClCompile><PreprocessorDefinitions>AERO_WITH_CUDA;%(PreprocessorDefinitions)</PreprocessorDefinitions></ClCompile>
    <Link><AdditionalLibraryDirectories>$(CudaToolkitDir)\lib\x64;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>cudart_static.lib;%(AdditionalDependencies)</AdditionalDependencies></Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <None Include="..\source\eulersolver\eulersolver_cuda_tests.cu" />
    <ClInclude Include="..\source\eulersolver\eulersolver_cuda_tests.cuh" />
    <Object Include="$(IntDir)eulersolver_cuda_tests.obj" Condition="'$(WithCuda)'=='true'" />
  </ItemGroup>
  <Target Name="CompileEulersolverCudaTests" BeforeTargets="Link" Condition="'$(WithCuda)'=='true'"
    Inputs="$(MSBuildProjectDirectory)\..\source\eulersolver\eulersolver_cuda_tests.cu;$(MSBuildProjectDirectory)\..\source\eulersolver\eulersolver_cuda_tests.cuh;$(MSBuildProjectDirectory)\..\source\parallel\kernel_math.h;$(MSBuildProjectDirectory)\..\source\cuda\runtime.h;$(MSBuildProjectDirectory)\..\source\mesh\mesh_index.h;$(MSBuildProjectDirectory)\..\source\eulersolver\euler.h;$(MSBuildProjectDirectory)\..\source\eulersolver\lax_friedrichs.h;$(MSBuildProjectDirectory)\..\source\eulersolver\characteristic.h;$(MSBuildProjectDirectory)\..\source\eulersolver\roe.h;$(MSBuildProjectFullPath)"
    Outputs="$(IntDir)eulersolver_cuda_tests.obj">
    <Error Condition="!Exists('$(CudaToolkitDir)\bin\nvcc.exe')" Text="CUDA toolkit not found; set CudaToolkitDir or WithCuda=false." />
    <Exec Command="call &quot;$(VCInstallDir)Auxiliary\Build\vcvars64.bat&quot; -vcvars_ver=$(VCToolsVersion) &gt;nul &amp;&amp; &quot;$(CudaToolkitDir)\bin\nvcc.exe&quot; -std=c++11 -arch=sm_$(CudaArchitecture) $(CudaCompatibilityFlags) $(EulerCudaFlags) -Xcompiler=/utf-8 -c &quot;$(MSBuildProjectDirectory)\..\source\eulersolver\eulersolver_cuda_tests.cu&quot; -o &quot;$(IntDir)eulersolver_cuda_tests.obj&quot;" />
  </Target>
  <Target Name="RunEulersolverTests" AfterTargets="Build"
    Condition="'$(RunEulersolverTests)'=='true' and '$(DesignTimeBuild)'!='true'">
    <Exec Command="&quot;$(TargetPath)&quot; $(EulerTestArguments)" WorkingDirectory="$(MSBuildProjectDirectory)\.." />
  </Target>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Import Project="publish_program.targets" />
</Project>
