<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" DefaultTargets="Build" ToolsVersion="Current">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{A5A05EB5-4432-4B03-9502-8FF852AE7013}</ProjectGuid>
    <Keyword>Win32Proj</Keyword>
    <RootNamespace>aero</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <ImportDirectoryBuildProps>false</ImportDirectoryBuildProps>
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'!='Debug'">false</UseDebugLibraries>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <WithCuda Condition="'$(WithCuda)'==''">false</WithCuda>
    <WithOpenMP Condition="'$(WithOpenMP)'==''">true</WithOpenMP>
    <CudaToolkitDir Condition="'$(CudaToolkitDir)'==''">$(CUDA_PATH)</CudaToolkitDir>
    <CudaArchitecture Condition="'$(CudaArchitecture)'==''">86</CudaArchitecture>
    <EulerVariant>cpu</EulerVariant>
    <EulerVariant Condition="'$(WithCuda)'=='true'">cuda-sm$(CudaArchitecture)</EulerVariant>
    <EulerVariant Condition="'$(WithOpenMP)'=='false'">$(EulerVariant)-serial</EulerVariant>
    <OutDir>$(MSBuildProjectDirectory)\..\build\msvs\$(Platform)\$(Configuration)\$(EulerVariant)\</OutDir>
    <IntDir>$(OutDir)obj\$(MSBuildProjectName)\</IntDir>
    <TargetName>eulersolver_tests</TargetName>
  </PropertyGroup>
  <Import Project="module_compiler.props" />
  <ItemDefinitionGroup>
    <ClCompile>
      <OpenMPSupport Condition="'$(WithOpenMP)'=='true'">true</OpenMPSupport>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <BasicRuntimeChecks>EnableFastChecks</BasicRuntimeChecks>
      <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClInclude Include="..\source\eulersolver\characteristic.h" />
    <ClInclude Include="..\source\eulersolver\roe.h" />
    <ClInclude Include="..\source\eulersolver\euler.h" />
    <ClInclude Include="..\source\eulersolver\lax_friedrichs.h" />
    <ClCompile Include="..\source\eulersolver\eulersolver_tests.cpp" />
    <None Include="..\source\eulersolver\README.txt" />
    <None Include="..\source\eulersolver\eulersolver.mk" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="aero_eulersolver.vcxproj">
      <Project>{4FCA0C0C-DA79-463C-99C2-76F0CC9F8456}</Project>
    </ProjectReference>
  </ItemGroup>
  <PropertyGroup>
    <RunEulersolverTests Condition="'$(RunEulersolverTests)'==''">true</RunEulersolverTests>
    <EulerTestArguments Condition="'$(RequireCudaTests)'=='true'">--require-cuda</EulerTestArguments>
    <CudaCompatibilityFlags Condition="'$(AllowUnsupportedCudaHostCompiler)'=='true'">-allow-unsupported-compiler -D_ALLOW_COMPILER_AND_STL_VERSION_MISMATCH</CudaCompatibilityFlags>
    <EulerCudaFlags Condition="'$(Configuration)'=='Debug'">-G -g -O0 -Xcompiler=/MTd</EulerCudaFlags>
    <EulerCudaFlags Condition="'$(Configuration)'!='Debug'">-O2 -Xcompiler=/MT</EulerCudaFlags>
    <LocalDebuggerWorkingDirectory>$(MSBuildProjectDirectory)\..</LocalDebuggerWorkingDirectory>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(WithCuda)'=='true'">
    <ClCompile>
      <PreprocessorDefinitions>AERO_WITH_CUDA;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(CudaToolkitDir)\lib\x64;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>cudart_static.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <None Include="..\source\eulersolver\eulersolver_cuda_tests.cu" />
    <ClInclude Include="..\source\eulersolver\eulersolver_cuda_tests.cuh" />
    <Object Include="$(IntDir)eulersolver_cuda_tests.obj" Condition="'$(WithCuda)'=='true'" />
  </ItemGroup>
  <!-- Заголовки ядра учитываются при решении, нужно ли заново запускать nvcc. -->
  <ItemGroup>
    <GpuKernelInput Include="..\source\eulersolver\eulersolver_cuda_tests.cu" />
    <GpuKernelInput Include="..\source\eulersolver\eulersolver_cuda_tests.cuh" />
    <GpuKernelInput Include="..\source\parallel\kernel_math.h" />
    <GpuKernelInput Include="..\source\cuda\runtime.h" />
    <GpuKernelInput Include="..\source\mesh\mesh_index.h" />
    <GpuKernelInput Include="..\source\eulersolver\euler.h" />
    <GpuKernelInput Include="..\source\eulersolver\lax_friedrichs.h" />
    <GpuKernelInput Include="..\source\eulersolver\characteristic.h" />
    <GpuKernelInput Include="..\source\eulersolver\roe.h" />
    <GpuKernelInput Include="..\source\cuda\device_scope.h" />
  </ItemGroup>
  <Target Name="CompileEulersolverCudaTests" BeforeTargets="Link" Condition="'$(WithCuda)'=='true'" Inputs="@(GpuKernelInput);$(MSBuildProjectFullPath)" Outputs="$(IntDir)eulersolver_cuda_tests.obj">
    <Error Condition="!Exists('$(CudaToolkitDir)\bin\nvcc.exe')" Text="CUDA toolkit not found; set CudaToolkitDir or WithCuda=false." />
    <Exec Command="call &quot;$(VCInstallDir)Auxiliary\Build\vcvars64.bat&quot; -vcvars_ver=$(VCToolsVersion) &gt;nul &amp;&amp; &quot;$(CudaToolkitDir)\bin\nvcc.exe&quot; -std=c++11 -arch=sm_$(CudaArchitecture) $(CudaCompatibilityFlags) $(EulerCudaFlags) -Xcompiler=/utf-8 -c &quot;$(MSBuildProjectDirectory)\..\source\eulersolver\eulersolver_cuda_tests.cu&quot; -o &quot;$(IntDir)eulersolver_cuda_tests.obj&quot;" />
  </Target>
  <Target Name="RunEulersolverTests" AfterTargets="Build" Condition="'$(RunEulersolverTests)'=='true' and '$(DesignTimeBuild)'!='true'">
    <Exec Command="&quot;$(TargetPath)&quot; $(EulerTestArguments)" WorkingDirectory="$(MSBuildProjectDirectory)\.." />
  </Target>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Import Project="publish_program.targets" />
</Project>
