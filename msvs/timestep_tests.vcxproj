  <Target Name="CompileTimestepCudaTests" BeforeTargets="Link" Condition="'$(WithCuda)'=='true'"
    Inputs="$(MSBuildProjectDirectory)\..\source\timestep\timestep_cuda_tests.cu;$(MSBuildProjectDirectory)\..\source\timestep\timestep_cuda_tests.cuh;$(MSBuildProjectDirectory)\..\source\parallel\kernel_math.h;$(MSBuildProjectDirectory)\..\source\cuda\runtime.h;$(MSBuildProjectDirectory)\..\source\mesh\mesh_index.h;$(MSBuildProjectDirectory)\..\source\timestep\timestep.h;$(MSBuildProjectDirectory)\..\source\explicit\explicit.h;$(MSBuildProjectDirectory)\..\source\eulersolver\lax_friedrichs.h;$(MSBuildProjectDirectory)\..\source\eulersolver\euler.h;$(MSBuildProjectFullPath)"
