    <IntDir>$(OutDir)obj\$(MSBuildProjectName)\</IntDir><TargetName>timestep_tests</TargetName>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
