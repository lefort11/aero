    <Error Condition="!Exists('$(CudaToolkitDir)\bin\nvcc.exe')" Text="CUDA toolkit not found; set CudaToolkitDir or WithCuda=false." />
    <Exec Command="call &quot;$(VCInstallDir)Auxiliary\Build\vcvars64.bat&quot; -vcvars_ver=$(VCToolsVersion) &gt;nul &amp;&amp; &quot;$(CudaToolkitDir)\bin\nvcc.exe&quot; -std=c++11 -arch=sm_$(CudaArchitecture) $(CudaCompatibilityFlags) $(TimestepCudaFlags) -Xcompiler=/utf-8 -c &quot;$(MSBuildProjectDirectory)\..\source\timestep\timestep_cuda_tests.cu&quot; -o &quot;$(IntDir)timestep_cuda_tests.obj&quot;" />
  </Target>
  <Target Name="RunTimestepTests" AfterTargets="Build"
    Condition="'$(RunTimestepTests)'=='true' and '$(DesignTimeBuild)'!='true'">
    <Exec Command="&quot;$(TargetPath)&quot; $(TimestepTestArguments)" WorkingDirectory="$(MSBuildProjectDirectory)\.." />
  </Target>
