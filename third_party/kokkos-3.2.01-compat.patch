 }  // namespace
 
-unsigned long *CudaInternal::constantMemHostStaging = nullptr;
-cudaEvent_t CudaInternal::constantMemReusable       = nullptr;
+// Создаём закреплённую память и событие на первом обращении к этой карте.
+void CudaConstantBuffer::acquire() {
+  std::lock_guard<std::mutex> guard(mutex);
+  if (users == 0) {
+    CUDA_SAFE_CALL(cudaMallocHost(reinterpret_cast<void**>(&staging),
+                                  CudaTraits::ConstantMemoryUsage));
+    const auto status = cudaEventCreateWithFlags(&reusable, cudaEventDisableTiming);
+    if (status != cudaSuccess) {
+      cudaFreeHost(staging);
+      CUDA_SAFE_CALL(status);
+    }
+  }
+  ++users;
+}
+
+void CudaConstantBuffer::release() {
+  std::lock_guard<std::mutex> guard(mutex);
+  if (--users == 0) {
+    // Последний запуск мог ещё читать аргументы из буфера этой карты.
+    CUDA_SAFE_CALL(cudaEventSynchronize(reusable));
+    CUDA_SAFE_CALL(cudaEventDestroy(reusable));
+    CUDA_SAFE_CALL(cudaFreeHost(staging));
+  }
+}
 
